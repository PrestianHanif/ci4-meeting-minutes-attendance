# Environment & Secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# Writable runtime files
/writable/cache/*
!/writable/cache/.gitkeep
/writable/debugbar/*
!/writable/debugbar/.gitkeep
/writable/logs/*
!/writable/logs/.gitkeep
/writable/session/*
!/writable/session/.gitkeep
/writable/uploads/*
!/writable/uploads/.gitkeep

# User uploaded assets (signatures, photos, generated PDFs)
/public/uploads/*
!/public/uploads/.gitkeep

# Archives & OS/IDE files
*.zip
*.log
cookies.txt
.DS_Store
Thumbs.db
.vscode/
.idea/
